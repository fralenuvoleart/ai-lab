# Open WebUI Environment Variables
# Copy to .env: cp .env.example .env

# Security — generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Port (accessible via SSH tunnel at localhost:3000, or via Caddy domain)
WEBUI_PORT=3000

# User registration — set to "false" AFTER creating your admin account
ENABLE_SIGNUP=true

# API Provider: Groq (OpenAI-compatible)
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_API_BASE_URL=https://api.groq.com/openai/v1

# API Provider: OpenRouter (configure via Admin Panel → Settings → Connections)
# Or set via env:
# OPENROUTER_API_KEY=

# RAG Embeddings — offloads CPU from VPS, costs ~$0.02/1M tokens
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
# Uses the same OpenRouter key you configured in the UI; set explicitly if needed:
# RAG_OPENAI_API_KEY=sk-or-...

# OpenSERP self-hosted web search (no API keys needed)
# OPENSERP_BASE_URL=http://openserp:7000
