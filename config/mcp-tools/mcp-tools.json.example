{
  "mcpServers": {
    "fetch": {
      "command": "/root/.local/bin/mcp-server-fetch"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PAT"
      }
    },
    "searxng": {
      "command": "/root/.local/share/pipx/venvs/basic-memory/bin/python",
      "args": [
        "/opt/ai-lab/config/searxng/mcp_server.py"
      ]
    },
    "rss-reader": {
      "command": "npx",
      "args": [
        "-y",
        "rss-reader-mcp"
      ]
    },
    "twitterapi-io": {
      "command": "npx",
      "args": [
        "-y",
        "@twitterapi_io/mcp-server"
      ],
      "env": {
        "TWITTERAPI_IO_API_KEY": "YOUR_TWITTERAPI_IO_API_KEY"
      }
    }
  }
}