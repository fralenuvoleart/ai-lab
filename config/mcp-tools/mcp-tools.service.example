[Unit]
Description=MCP Tools (Fetch + GitHub via mcpo)
After=network-online.target docker.service

[Service]
Type=simple
User=root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_GITHUB_PAT_mToc1zKOq7tELchJHG1LQLJ683kUDVcHwVd3l7498LLQ2TVYR7DIOEcAEsv
ExecStart=/root/.local/bin/mcpo --port 8001 --config /root/.mcpo-tools.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
