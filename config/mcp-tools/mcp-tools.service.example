[Unit]
Description=MCP Tools (Fetch + GitHub + SearXNG + RSS + Twitter via mcpo)
After=network-online.target docker.service

[Service]
Type=simple
User=root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_GITHUB_PAT
Environment=TWITTERAPI_IO_API_KEY=YOUR_TWITTERAPI_IO_API_KEY
ExecStart=/root/.local/bin/mcpo --port 8001 --config /root/.mcpo-tools.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
