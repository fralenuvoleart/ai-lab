# =============================================================================
# AI-LAB Environment Variables Template
# Copy to .env and fill in your keys: cp .env.example .env
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google ---
GOOGLE_AI_API_KEY=your-key-here

# --- Hetzner Cloud ---
HCLOUD_TOKEN=your-hetzner-api-token

# --- Sevalla ---
SEVALLA_API_KEY=your-sevalla-api-key
SEVALLA_COMPANY_ID=your-company-uuid

# --- Qdrant (Vector DB) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=optional-secure-key

# --- PostgreSQL ---
POSTGRES_USER=ailab
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ailab
POSTGRES_PORT=5432

# --- Caddy (Reverse Proxy) ---
CADDY_ACME_EMAIL=francesco.csto@gmail.com

# --- Docker Registry ---
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-token
